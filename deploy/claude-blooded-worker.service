[Unit]
Description=claude-blooded reels render worker
After=network-online.target postgresql.service claude-blooded-api.service

[Service]
User=blooded
Group=blooded
WorkingDirectory=/opt/claude-blooded
EnvironmentFile=/etc/claude-blooded.env
ExecStart=/opt/claude-blooded/.venv/bin/python -m app.workers.worker
Restart=always
RestartSec=15
Nice=5

[Install]
WantedBy=multi-user.target
