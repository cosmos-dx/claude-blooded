# Copy to .env (local) or /etc/claude-blooded.env (server). Never commit real values.
# Comments must sit on their own line: systemd's EnvironmentFile keeps anything after "=" as the value.

# production | development
APP_ENV=production
PUBLIC_BASE_URL=https://reels.example.com
# comma-separated; these accounts see costs and the admin page
ADMIN_EMAILS=you@example.com
# 64+ random chars: python3 -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET=
DATA_DIR=/var/lib/claude-blooded
# false only while the site is served over plain HTTP
COOKIE_SECURE=true

# Database (Postgres 13+). The app creates and uses the schema named in config (studio).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/claude_blooded?sslmode=prefer

# LLM providers: the router tries them in the order set per profile in config/app.yaml
ANTHROPIC_API_KEY=
# Amazon Bedrock API key (sent as a bearer token)
AWS_BEDROCK_API_KEY_ANTHROPIC=
AWS_BEDROCK_REGION=ap-south-1
# https://ai.megallm.io (Anthropic-compatible endpoint)
MEGALLM_API_KEY=

# Voice
ELEVEN_LABS_API_KEY=

# Payments: razorpay | mock (mock is refused when APP_ENV=production)
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Login emails (OTP): smtp | console (console prints codes to the log; development only)
MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Rendering
REEL_FONT_DIR=/usr/share/fonts/reel
RENDER_PROCESSES=1

# Optional: YOUTUBE_API_KEY enables the Trend Scout's YouTube source
YOUTUBE_API_KEY=
USD_INR=88
